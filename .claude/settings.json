{
  "permissions": {
    "defaultMode": "default",
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "Edit(./experiments/**)",
      "Edit(./research/ai/**)",
      "Edit(./research/notes/**)",
      "Edit(./research/deliverables/**)",
      "Edit(./research/sources/public/links.md)",
      "WebFetch(domain:nixos.org)",
      "WebFetch(domain:nix.dev)",
      "WebFetch(domain:ziglang.org)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(~/.ssh/**)",
      "Bash(git push *)",
      "Edit(./flake.nix)",
      "Edit(./flake.lock)",
      "Edit(./research/ai/web-log.md)",
      "Edit(./CLAUDE.md)",
      "Edit(./research/CLAUDE.md)",
      "Edit(./.claude/**)",
      "Edit(./research/sources/private/**)",
      "Edit(./research/sources/confidential/**)",
      "Edit(./research/sources/public/ai-guidelines/**)",
      "mcp__claude_ai_Gmail",
      "mcp__claude_ai_Claude_Docs",
      "mcp__claude_ai_Google_Drive"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "filesystem": {
      "denyRead": ["~/", "./.env"],
      "allowRead": ["."],
      "denyWrite": [
        "./research/sources",
        "./CLAUDE.md",
        "./research/CLAUDE.md",
        "./flake.nix",
        "./flake.lock",
        "./research/ai/web-log.md"
      ]
    },
    "network": {
      "allowedDomains": []
    }
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/nix-env.sh", "timeout": 300 } ] }
    ],
    "FileChanged": [
      { "matcher": "flake.nix|flake.lock",
        "hooks": [ { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/nix-env.sh", "timeout": 300 } ] }
    ],
    "CwdChanged": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/nix-env.sh", "timeout": 300 } ] }
    ],
    "PreToolUse": [
      { "matcher": "WebSearch",
        "hooks": [ { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/websearch-gate.sh" } ] }
    ],
    "PostToolUse": [
      { "matcher": "WebSearch|WebFetch",
        "hooks": [ { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/web-log.sh" } ] }
    ]
  }
}
